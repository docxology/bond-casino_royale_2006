cff-version: 1.2.0
message: "Casino Royale (2006) LE CHIFFRE mission software (PROJECT BOND)."
title: "Casino Royale: LE CHIFFRE — Special-Agent Mission Software"
abstract: >
  Deterministic special-agent mission software mapping the film's set pieces to
  four tested algorithms: a Texas hold'em game-theory engine, chip-movement
  money-laundering detection, parkour mobility routing, and digitalis poison
  detection, bound as a BOND-API MissionProvider.
authors:
  - family-names: Friedman
    given-names: Daniel Ari
    orcid: "https://orcid.org/0000-0001-6232-9096"
    affiliation: "Active Inference Institute"
keywords:
  - "Texas hold'em"
  - "pot odds"
  - "hand equity"
  - "opponent modelling"
  - "money-laundering detection"
  - "chip movement"
  - "parkour routing"
  - "mobility graphs"
  - "digitalis"
  - "poison detection"
license: MIT
